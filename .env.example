# ==========================================
# PRIMECARE CHATBOT SERVICE (Python / FastAPI)
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env
# ==========================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Service ---
CHATBOT_SERVICE_PORT=9004

# --- JWT: phải GIỐNG HỆT jwt.secret-key của user-service (HS512, >= 64 byte) ---
JWT_SECRET_KEY=5c4b406804cf14ef2fea719598e07d7d7c6c15d26eea55040597cb2ab6a6d35b

# --- Redis (lịch sử chat, rate limit, cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Các service Java (gọi trực tiếp, không qua gateway) ---
USER_SERVICE_URL=http://localhost:9001
CLINIC_SERVICE_URL=http://localhost:9003

# --- Eureka (để gateway route lb://chatbot-service) ---
EUREKA_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka/
# Địa chỉ mà gateway dùng để gọi chatbot. Để trống = tự lấy theo máy.
# Chạy trong Docker mà gateway chạy trên máy: đặt host.docker.internal hoặc IP máy.
EUREKA_INSTANCE_HOST=

# --- Giới hạn ---
MAX_MESSAGE_CHARS=500
RATE_LIMIT_PER_MINUTE=20

# --- Cách hiểu ý định đặt lịch: model (model tự hiểu) | rules (ép nút theo từ khóa) ---
INTENT_MODE=model
